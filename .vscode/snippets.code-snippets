  "Generate API Service": {
    "scope": "dart",
    "prefix": "api",
    "body": [
      "library api_${1:model};",
      "",
      "import 'dart:async';",
      "import 'dart:io';",
      "",
      "import 'package:chopper/chopper.dart';",
      "import 'package:chopper_built_value/chopper_built_value.dart';",
      "import 'package:http/io_client.dart' as http;",
      "",
      "import 'package:deepomatic_lens/interceptors/auth_header.dart';",
      "import 'package:deepomatic_lens/interceptors/language_header.dart';",
      "",
      "part 'api_${1:model}.chopper.dart';",
      "",
      "@ChopperApi(baseUrl: '/${1:model}s')",
      "abstract class Api${2:Model}Service extends ChopperService {",
      "  // a helper method to quickly create an instance of the service",
      "  static Api${2:Model}Service create(String baseUrl) {",
      "    final client = ChopperClient(",
      "      client: http.IOClient(",
      "        HttpClient()..connectionTimeout = const Duration(seconds: ${3:5}),",
      "      ),",
      "      baseUrl: Uri.parse(baseUrl),",
      "      services: [",
      "        _$Api${2:Model}Service(),",
      "      ],",
      "      interceptors: [",
      "        AuthHeaderInterceptor(),",
      "        LangHeaderInterceptor(),",
      "        const HeadersInterceptor({'Content-Type': 'application/json'}),",
      "        HttpLoggingInterceptor(),",
      "        CurlInterceptor(),",
      "      ],",
      "      converter: BuiltValueConverter(${1/_//g:model}Serializers),",
      "    );",
      "    return _$Api${2:Model}Service(client);",
      "  }",
      "}",
      ""
    ],
    "description": "Generate API Service"
  },
